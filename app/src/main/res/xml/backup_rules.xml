<?xml version="1.0" encoding="utf-8"?>
<!--
  UNA-04 (Truth Car 3): pre-Android-12 Auto Backup rules (this file is
  ignored on API 31+; data_extraction_rules.xml governs there). The
  plate promises "DATA: ON THIS PHONE ONLY" and the manifest sets
  allowBackup="false"; these excludes state the same law inside the
  rules file itself, so no domain is ever eligible.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
