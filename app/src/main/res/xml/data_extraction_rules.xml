<?xml version="1.0" encoding="utf-8"?>
<!--
  UNA-04 (Truth Car 3) + Audit R2 #93: the app's plate promises "DATA: ON
  THIS PHONE ONLY". Together with android:allowBackup="false", these
  rules make that sentence true on Android 12+: NOTHING is extracted for
  cloud backup and NOTHING moves in a device-to-device transfer — every valid
  domain is excluded in both sections, in EITHER storage tree. The
  device_* domains are not decoration: the Room database (sessions,
  receipts, captured notifications) is built in device-protected storage
  for Direct Boot, the platform maps device_* to that separate tree, and
  on some OEM devices allowBackup="false" alone cannot disable D2D
  migration — these device-transfer excludes are the operative guard.
  The seal marker (credential-encrypted prefs) and the sealed-session
  rows (device-protected database) now sit on the SAME side of the
  boundary: neither ever leaves the phone, so a transfer can never
  restore a desynchronised half-state.
  FullBackupContent cure (#166): an earlier draft also listed a
  "device_external" exclude in both sections. That domain does not
  exist - Android's documented set (developer.android.com/identity/
  data/autobackup, "Syntax for include and exclude elements") is
  exactly nine: root, file, database, sharedpref, external,
  device_root, device_file, device_database, device_sharedpref. The
  device_* counterparts exist only for root, file, database and
  sharedpref; external (getExternalFilesDir()) has no
  device-protected counterpart, so device-protected external
  storage cannot be excluded through this mechanism - the invalid
  lines were removed, not renamed. The app never writes external
  storage at all (no getExternalFilesDir use anywhere in the tree),
  and every root it does use stays excluded in both sections below.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
