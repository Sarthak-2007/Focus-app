<resources>
    <string name="app_name">Monolith</string>
    <string name="accessibility_service_label">Monolith Distraction Airlock</string>
    <string name="accessibility_service_description">During an active Monolith focus session only, Monolith reads the content of the foreground window on this device to detect blocked app launches, Shorts and Reels feeds, blocked website addresses in the browser, and tampering in Settings or the installer, and presents the Intention Airlock screen. Everything is processed on this device; nothing is sent anywhere.</string>
    <string name="device_admin_label">Monolith Device Admin</string>
    <string name="device_admin_description">Shows a warning when Monolith\'s device admin is about to be turned off. It only adds friction and a warning — Android still lets you deactivate it and uninstall Monolith; it does not prevent either.</string>
    <string name="device_admin_add_explanation">Turning this on only lets Monolith show a warning if you later go to turn its device admin off. It adds friction and a warning — it does not prevent deactivation or uninstall, and Android still lets you do both.</string>
    <string name="accessibility_service_summary">Guards a sealed focus session: blocked apps, Shorts/Reels and blocked sites are intercepted, including in split-screen and picture-in-picture. Open Monolith to configure what is blocked.</string>
    <string name="widget_description">Seal status at a glance: sealed, open, or the next seal.</string>
    <string name="notification_channel_name">Monolith Active Shield</string>
    <string name="notification_channel_desc">Shows the active focus session\'s countdown and shield status.</string>
