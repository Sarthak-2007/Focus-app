<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal & System Permissions for Reliable App Blocking -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Issues #280 + #319 F2 + #309 F2: exact-alarm grant, asked
         only when the user first enables a routine (MainActivity) —
         never a first-run gate. Routine boundaries and the
         release-retry cadence fire on the minute when the grant is
         held; ExactAlarm probes the grant and falls back to the
         inexact arm whenever it is absent (the heartbeat
         reconciles). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Issue #143 F4: declared so the DND gate can read the
         interruption filter and, ONLY where the user has granted
         notification-policy access in system settings, engage /
         restore Do-Not-Disturb around a seal. The declaration
         alone grants nothing; DndGate checks the live grant. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Declared so MainActivity can fire Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS directly (issue #26) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Audit R6 #340 F25: held ONLY across a single shield enforcement
         tick (15 s timeout, released before the cadence gap) — never for
         a session's whole length. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility queries for launcher apps so Monolith can list installed apps on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Audit R6 #341 F03: OEM security centres are addressable
             surfaces (tamper guard + FIX routing targets). -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.permcenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.permissionmanager" />
        <!-- Issue #121: structural time-critical classification —
             TimeCriticalApps resolves which packages answer the
             platform alarm intents and which declare/handle the
             calendar, so an alarm or calendar app is safeguarded by
             what it DOES, not by the words in its name. -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_TIMERS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
    </queries>

    <!-- UNA-04 (Truth Car 3): PARK's plate prints "DATA: ON THIS PHONE
         ONLY" — so backup is OFF, in every regime: allowBackup=false
         (kills Auto Backup and cloud backup), and both rules files
         exclude every domain for cloud backup AND device transfer, so
         the sentence stays true even if this flag is ever revisited. -->
    <application
        android:name=".MonolithApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Issue #274: Quick Settings tile — in-session glance +
             one-tap entry without a full launcher trip. -->
        <service
            android:name=".service.MonolithTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Issue #305 (F2): launcher icon variants. Both aliases ship
             DISABLED — .MainActivity's own entry stays the one live
             launcher icon until the PARK picker row (the priced F2
             residue) enables a variant via PackageManager. Re-authored
             2026-10-31 (K7) from lost commit b486565. -->
        <activity-alias
            android:name=".LauncherIconMark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mark"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconMonogram"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_monogram"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Direct-Boot Aware Foreground Service for active focus session & call-aware usage polling -->
        <!-- Issue #328 (Audit R5, Zario): stopWithTask=false — a
             Recents swipe of the Monolith task must not take the
             shield down with it; the service answers the swipe in
             onTaskRemoved by re-arming while a session is protected. -->
        <service
            android:name=".service.MonolithShieldService"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Active app-blocking focus session timer and usage monitor" />
        </service>

        <!-- Issue #308: polls the grant during a permission FIX trip
             and returns the user to the app the moment it lands. -->
        <service
            android:name=".service.PermissionReturnService"
            android:enabled="true"
            android:exported="false" />

        <!-- Direct-Boot Aware Window, Shorts/Reels Sniper, Settings Blocker & URL Bar Interceptor -->
        <service
            android:name=".service.MonolithAccessibilityService"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Silent Notification Catcher & Persistent Digest Service -->
        <service
            android:name=".service.MonolithNotificationListener"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:label="@string/notification_catcher_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Direct-Boot Receiver (LOCKED_BOOT_COMPLETED + BOOT_COMPLETED) -->
        <receiver
            android:name=".service.MonolithBootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Audit R6 #340 F53: the unlock moment itself is a
                     resurrection trigger — a shield that died between
                     boot and first unlock is re-asserted at the one
                     instant the user is guaranteed to touch the phone.
                     USER_UNLOCKED (not USER_PRESENT): once per unlock
                     cycle, never per screen wake. -->
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.REBOOT" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- Issue #122: battery events (both on the implicit-broadcast exemption list) — the receiver refreshes the shield's battery warning even if the service's own dynamic receiver has not been re-registered yet. -->
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.os.action.POWER_SAVE_MODE_CHANGED" />
            </intent-filter>
            <!-- Issue #81 F5: a component state change anywhere
                 (including Monolith's own components via adb /
                 pm disable) prompts a heartbeat reconcile, whose
                 pass re-reads the critical components' enabled
                 states and latches the live session's gap if one
                 was disabled. The poll in the pass is the proof;
                 this receiver only shortens the time to notice. -->
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Issue #281 (R5 supplement): directBootAware is kept ONLY on
             the four components with a real pre-unlock job — the boot
             receiver and the three services it raises before first
             unlock so an active session stays sealed across a reboot
             (MonolithBootReceiver's filed design). The three receivers
             below have no pre-unlock job (alarm hints for a
             credential-protected store, a retry hint, admin events)
             and no longer declare it. -->
        <receiver
            android:name=".service.RoutineAlarmReceiver"
            android:exported="false" />

        <!-- Issue #155 (F1): the home-screen glance widget. -->
        <receiver
            android:name=".widget.MonolithWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/monolith_widget_info" />
        </receiver>

        <!-- Issue #309 F7: package added/removed/replaced/changed —
             reconcile the app catalogue at install time instead of
             discovering installs on the next UI-driven sync. These
             are protected system broadcasts; exported=false still
             receives them. -->
        <receiver
            android:name=".service.MonolithPackageReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Slice E (Draht): the release-retry cadence's hint. -->
        <receiver
            android:name=".service.ReleaseRetryReceiver"
            android:exported="false" />

        <!-- Issue #339 (Second-pass F3): the Safe Break's end is a
             scheduled event — this receiver posts the deduped
             'Break's over' notification from the exact alarm
             BreakEndScheduler arms at break entry. -->
        <receiver
            android:name=".service.BreakEndReceiver"
            android:exported="false" />

        <!-- Device Admin (DeviceAdminReceiver): friction + a warning
             on deactivation only — it does not prevent deactivation
             or uninstall (issue #44). -->
        <receiver
            android:name=".service.MonolithDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="false"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
