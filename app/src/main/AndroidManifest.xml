<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal & System Permissions for Reliable App Blocking -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Issue #280: exact-alarm grant, asked only when the user
         first enables a routine (MainActivity) — never a first-run
         gate. The chain alarm falls back to inexact without it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Declared so MainActivity can fire Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS directly (issue #26) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility queries for launcher apps so Monolith can list installed apps on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- UNA-04 (Truth Car 3): PARK's plate prints "DATA: ON THIS PHONE
         ONLY" — so backup is OFF, in every regime: allowBackup=false
         (kills Auto Backup and cloud backup), and both rules files
         exclude every domain for cloud backup AND device transfer, so
         the sentence stays true even if this flag is ever revisited. -->
    <application
        android:name=".MonolithApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Direct-Boot Aware Foreground Service for active focus session & call-aware usage polling -->
        <service
            android:name=".service.MonolithShieldService"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Active app-blocking focus session timer and usage monitor" />
        </service>

        <!-- Issue #308: polls the grant during a permission FIX trip
             and returns the user to the app the moment it lands. -->
        <service
            android:name=".service.PermissionReturnService"
            android:enabled="true"
            android:exported="false" />

        <!-- Direct-Boot Aware Window, Shorts/Reels Sniper, Settings Blocker & URL Bar Interceptor -->
        <service
            android:name=".service.MonolithAccessibilityService"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Silent Notification Catcher & Persistent Digest Service -->
        <service
            android:name=".service.MonolithNotificationListener"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:label="Monolith Notification Catcher"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Direct-Boot Receiver (LOCKED_BOOT_COMPLETED + BOOT_COMPLETED) -->
        <receiver
            android:name=".service.MonolithBootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <!-- Issue #81 F5: a component state change anywhere
                 (including Monolith's own components via adb /
                 pm disable) prompts a heartbeat reconcile, whose
                 pass re-reads the critical components' enabled
                 states and latches the live session's gap if one
                 was disabled. The poll in the pass is the proof;
                 this receiver only shortens the time to notice. -->
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Issue #281 (R5 supplement): directBootAware is kept ONLY on
             the four components with a real pre-unlock job — the boot
             receiver and the three services it raises before first
             unlock so an active session stays sealed across a reboot
             (MonolithBootReceiver's filed design). The three receivers
             below have no pre-unlock job (alarm hints for a
             credential-protected store, a retry hint, admin events)
             and no longer declare it. -->
        <receiver
            android:name=".service.RoutineAlarmReceiver"
            android:exported="false" />

        <!-- Slice E (Draht): the release-retry cadence's hint. -->
        <receiver
            android:name=".service.ReleaseRetryReceiver"
            android:exported="false" />

        <!-- Device Admin (DeviceAdminReceiver): friction + a warning
             on deactivation only — it does not prevent deactivation
             or uninstall (issue #44). -->
        <receiver
            android:name=".service.MonolithDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="false"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
